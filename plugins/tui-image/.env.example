# Optional local settings for helper scripts.
# Copy to .env.local or set these variables in your shell if needed.

# Default Windows After Effects common plug-in folder:
# TUIIMAGE_PLUGIN_DIR=C:\Program Files\Adobe\Common\Plug-ins\7.0\MediaCore

# GPU rendering is experimental and disabled by default.
# Set to 1 only when intentionally testing the GPU path.
# TUIIMAGE_ENABLE_GPU=1

